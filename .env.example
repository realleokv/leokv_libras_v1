# Exemplo: configure estas variáveis no terminal. Não há carregamento automático de .env.
LIBRAS_ADMIN_TOKEN=substitua-por-um-token-aleatorio-com-pelo-menos-32-caracteres
LIBRAS_SECRET_KEY=substitua-por-outra-chave-aleatoria-com-pelo-menos-32-caracteres
LIBRAS_DATA_DIR=./data
# Origens permitidas explícitas separadas por vírgula, incluindo a usada no navegador.
LIBRAS_ALLOWED_ORIGINS=
# Histórico desativado por padrão; 1 habilita retenção limitada a 1000 eventos.
LIBRAS_LOG_HISTORY=0
